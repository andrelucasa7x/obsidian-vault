# PASSO 4 — CRIAR EDGE FUNCTION `fernando-vaz/index.ts`

Esta é a function principal. Recebe mensagem, raciocina, escreve memórias, devolve resposta.

```typescript
// supabase/functions/fernando-vaz/index.ts
import { serve } from 'https://deno.land/std@0.224.0/http/server.ts';
import { createClient } from 'npm:@supabase/supabase-js@2';
import { loadKits, formatKitsForLLM } from '../_shared/fernando-vaz/kits-catalog.ts';
import { FERNANDO_VAZ_SYSTEM, buildUserPrompt } from '../_shared/fernando-vaz/prompts.ts';
import type { FernandoVazRequest, WorkingState } from '../_shared/fernando-vaz/types.ts';

const AGENT_NAME = 'fernando-vaz';
const AGENT_SECRET = Deno.env.get('AGENT_SECRET') || 'socialagent2026';

serve(async (req) => {
  if (req.method !== 'POST') return new Response('Method not allowed', { status: 405 });

  // Auth
  const secret = req.headers.get('x-agent-secret');
  if (secret !== AGENT_SECRET) return new Response('Unauthorized', { status: 401 });

  const body: FernandoVazRequest = await req.json();
  const { tenant_id, phone, message } = body;

  if (!tenant_id || !phone || !message) {
    return new Response(JSON.stringify({ error: 'missing required fields' }), { status: 400 });
  }

  const supabase = createClient(
    Deno.env.get('SUPABASE_URL')!,
    Deno.env.get('SUPABASE_SERVICE_ROLE_KEY')!
  );

  try {
    // 1. Obter ou criar session
    const session_id = body.session_id || await getOrCreateSession(supabase, tenant_id, phone);

    // 2. Gravar mensagem do cliente
    await supabase.from('agent_conversations').insert({
      tenant_id, agent_name: AGENT_NAME, direction: 'in', message,
      context: { session_id, phone }
    });
    await supabase.from('whatsapp_conversations').insert({
      tenant_id, phone, direction: 'in', message,
      context_type: 'fernando_vaz', context_id: session_id
    });

    // 3. Carregar working state
    const working_state = await loadWorkingState(supabase, tenant_id, session_id);

    // 4. Carregar contexto
    const kits = await loadKits(supabase);
    const { data: tenant } = await supabase.from('tenants').select('*').eq('id', tenant_id).single();
    const { data: brand } = await supabase.from('brand_identity').select('*').eq('tenant_id', tenant_id).maybeSingle();
    const { data: history } = await supabase.from('agent_conversations')
      .select('direction,message')
      .eq('tenant_id', tenant_id)
      .eq('agent_name', AGENT_NAME)
      .order('created_at', { ascending: false })
      .limit(20);

    // 5. Montar prompt
    const user_prompt = buildUserPrompt({
      kits_catalog: formatKitsForLLM(kits),
      working_state,
      brand_identity_current: brand || {},
      tenant_current: tenant,
      conversation_history: (history || []).reverse(),
      incoming_message: message
    });

    // 6. Chamar LLM
    const llm_response = await callLLM(FERNANDO_VAZ_SYSTEM, user_prompt);

    // 7. Aplicar atualizações
    if (llm_response.updates?.brand_identity) {
      await supabase.from('brand_identity')
        .update(llm_response.updates.brand_identity)
        .eq('tenant_id', tenant_id);
    }
    if (llm_response.updates?.tenants) {
      await supabase.from('tenants')
        .update(llm_response.updates.tenants)
        .eq('id', tenant_id);
    }

    // 8. Tratar ação específica
    let step_advanced = false;
    let new_step: number | undefined;

    if (llm_response.action === 'classify_kit' && llm_response.kit_slug) {
      await supabase.from('tenants').update({ kit_slug: llm_response.kit_slug }).eq('id', tenant_id);
      await recordEpisodic(supabase, tenant_id, 'kit_classified', 
        `Tenant classificado como kit '${llm_response.kit_slug}'`, 0.9);
    }

    if (llm_response.action === 'invoke_human_tool' && llm_response.plan) {
      const { data: plan } = await supabase.from('agent_plans').insert({
        tenant_id,
        plan_name: llm_response.plan.name,
        description: llm_response.plan.description,
        created_by: AGENT_NAME,
        status: 'waiting_human',
        goals: llm_response.plan.goals || [],
        constraints: llm_response.plan.constraints || []
      }).select().single();
      if (plan) {
        working_state.pending_plan = plan.id;
      }
    }

    if (llm_response.action === 'advance_step' && typeof llm_response.new_step === 'number') {
      await supabase.from('brand_identity')
        .update({ onboarding_step: llm_response.new_step })
        .eq('tenant_id', tenant_id);
      step_advanced = true;
      new_step = llm_response.new_step;
      await recordEpisodic(supabase, tenant_id, 'step_advanced',
        `Avançou pro step ${llm_response.new_step}`, 0.8);
    }

    if (llm_response.action === 'completed') {
      await supabase.from('brand_identity')
        .update({ onboarding_step: 5 })
        .eq('tenant_id', tenant_id);
      await supabase.from('tenants')
        .update({ onboarding_completed: true })
        .eq('id', tenant_id);
      await recordEpisodic(supabase, tenant_id, 'onboarding_completed',
        'Onboarding concluído', 1.0);
    }

    // 9. Atualizar working state
    const new_working = {
      ...working_state,
      ...(llm_response.updates?.working_state || {}),
      last_question: llm_response.reply
    };
    await supabase.from('agent_working_memory').upsert({
      tenant_id,
      agent_name: AGENT_NAME,
      session_id,
      key: 'state',
      value: new_working,
      expires_at: new Date(Date.now() + 72 * 3600 * 1000).toISOString()
    }, { onConflict: 'tenant_id,agent_name,session_id,key' });

    // 10. Gravar resposta do agent
    await supabase.from('agent_conversations').insert({
      tenant_id, agent_name: AGENT_NAME, direction: 'out', message: llm_response.reply,
      context: { session_id, action: llm_response.action, reasoning: llm_response.reasoning_log }
    });
    await supabase.from('whatsapp_conversations').insert({
      tenant_id, phone, direction: 'out', message: llm_response.reply,
      context_type: 'fernando_vaz', context_id: session_id
    });

    // 11. Log
    await supabase.from('agent_logs').insert({
      tenant_id,
      agent_name: AGENT_NAME,
      action: llm_response.action,
      status: 'success',
      input: { message, session_id },
      output: { reply: llm_response.reply, action: llm_response.action }
    });

    return new Response(JSON.stringify({
      reply: llm_response.reply,
      step_advanced, new_step,
      kit_classified: llm_response.kit_slug,
      plan_invoked: llm_response.plan?.name,
      session_id
    }), { headers: { 'Content-Type': 'application/json' } });

  } catch (err) {
    console.error('fernando-vaz error', err);
    await supabase.from('agent_logs').insert({
      tenant_id, agent_name: AGENT_NAME, action: 'error', status: 'error',
      input: body, output: { error: String(err) }
    });
    return new Response(JSON.stringify({ error: String(err) }), { status: 500 });
  }
});

// --- helpers ---

async function getOrCreateSession(supabase: any, tenant_id: string, phone: string): Promise<string> {
  const { data: existing } = await supabase
    .from('whatsapp_sessions')
    .select('id')
    .eq('tenant_id', tenant_id)
    .eq('context_type', 'fernando_vaz')
    .eq('status', 'active')
    .gt('expires_at', new Date().toISOString())
    .maybeSingle();
  if (existing) return existing.id;

  const { data: created } = await supabase.from('whatsapp_sessions').insert({
    tenant_id,
    context_type: 'fernando_vaz',
    status: 'active',
    expires_at: new Date(Date.now() + 72 * 3600 * 1000).toISOString()
  }).select('id').single();
  return created.id;
}

async function loadWorkingState(supabase: any, tenant_id: string, session_id: string): Promise<WorkingState> {
  const { data } = await supabase.from('agent_working_memory')
    .select('value')
    .eq('tenant_id', tenant_id)
    .eq('agent_name', AGENT_NAME)
    .eq('session_id', session_id)
    .eq('key', 'state')
    .maybeSingle();
  if (data?.value) return data.value;
  return {
    current_step: 0,
    collected_fields: {},
    retry_count: 0
  };
}

async function recordEpisodic(supabase: any, tenant_id: string, event_type: string, description: string, importance: number) {
  await supabase.from('agent_episodic_memory').insert({
    tenant_id,
    agent_name: AGENT_NAME,
    event_type,
    event_description: description,
    importance_score: importance,
    context: {}
  });
}

async function callLLM(system: string, user: string): Promise<any> {
  const gemini_key = Deno.env.get('GEMINI_API_KEY');
  const deepseek_key = Deno.env.get('DEEPSEEK_API_KEY');

  // Try Gemini first
  if (gemini_key) {
    try {
      const res = await fetch(
        `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${gemini_key}`,
        {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            systemInstruction: { parts: [{ text: system }] },
            contents: [{ role: 'user', parts: [{ text: user }] }],
            generationConfig: {
              temperature: 0.7,
              responseMimeType: 'application/json'
            }
          })
        }
      );
      if (!res.ok) throw new Error(`Gemini ${res.status}`);
      const data = await res.json();
      const text = data.candidates?.[0]?.content?.parts?.[0]?.text;
      if (!text) throw new Error('Gemini empty response');
      return JSON.parse(text);
    } catch (e) {
      console.warn('Gemini failed, falling to DeepSeek', e);
    }
  }

  // Fallback DeepSeek
  if (deepseek_key) {
    const res = await fetch('https://api.deepseek.com/chat/completions', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${deepseek_key}`
      },
      body: JSON.stringify({
        model: 'deepseek-chat',
        messages: [
          { role: 'system', content: system },
          { role: 'user', content: user }
        ],
        temperature: 0.7,
        response_format: { type: 'json_object' }
      })
    });
    if (!res.ok) throw new Error(`DeepSeek ${res.status}`);
    const data = await res.json();
    return JSON.parse(data.choices[0].message.content);
  }

  throw new Error('no LLM available');
}
