export function formatKitsForLLM(kits: any[]): string {
  return kits.map(k => `
KIT "${k.slug}" — ${k.name}
Descrição: ${k.description}
Modo de publicação: ${k.publishing_mode}${k.requires_calendar ? ' (requer calendário)' : ''}
Volume: ${k.volume_per_week || 'não definido'}
Canais padrão: ${(k.default_channels || []).join(', ')}
Formatos editoriais: ${(k.editorial_structures || []).map((e: any) => e.name).join(', ')}
Campos obrigatórios: ${(k.required_fields || []).join(', ')}
`).join('\n---\n');
}
```

