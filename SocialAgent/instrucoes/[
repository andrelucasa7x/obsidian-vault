    tenant_id, agent_name: 'fernando-vaz', direction: 'out', message: greeting,
    context: { session_id: session.id, phone, bootstrap: true }
  });
  await supabase.from('whatsapp_conversations').insert({
    tenant_id, phone, direction: 'out', message: greeting,
    context_type: 'fernando_vaz', context_id: session.id
  });
  await supabase.from('agent_working_memory').insert({
    tenant_id, agent_name: 'fernando-vaz', session_id: session.id, key: 'state',
    value: { current_step: 0, collected_fields: {}, retry_count: 0 },
    expires_at: new Date(Date.now() + 72 * 3600 * 1000).toISOString()
  });

  return new Response(JSON.stringify({ session_id: session.id, greeting }), {
    headers: { 'Content-Type': 'application/json' }
